# SpotShare environment — copy to .env and fill in the secrets.
# Never commit .env.

# --- Server ---
PORT=8080

# --- Database (local: compose db service; prod: e.g. Neon) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spotshare
DB_USER=spotshare
DB_PASSWORD=change-me
# Appended verbatim to the JDBC URL, e.g. ?sslmode=require for Neon
DB_URL_PARAMS=

# --- Security. Generate with: openssl rand -base64 48 ---
JWT_SECRET=change-me-in-dev-only

# --- CORS. Comma-separated frontend origins (no trailing slash) ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Photo storage (S3-compatible). Leave empty to run without uploads;
# the upload endpoint will return 501 with a clear message. ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Geocoding ---
# Identifies SpotShare to Nominatim per its usage policy; set to your
# contact email in production, e.g. "SpotShare/1.0 (ops@example.com)"
NOMINATIM_USER_AGENT=SpotShare/1.0 (dev build)
