# SpotShare environment — copy to .env and fill in the secrets.
# Never commit .env.

# --- Server ---
PORT=8080

# --- Database (local: compose db service; prod: e.g. Neon) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spotshare
DB_USER=spotshare
DB_PASSWORD=change-me
# Appended verbatim to the JDBC URL, e.g. ?sslmode=require for Neon
DB_URL_PARAMS=

# --- Security. Generate with: openssl rand -base64 48 ---
JWT_SECRET=change-me-in-dev-only

# --- CORS. Comma-separated frontend origins (no trailing slash) ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (npm). Base URL of the backend API ---
VITE_API_BASE_URL=http://localhost:8080
